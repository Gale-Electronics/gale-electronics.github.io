{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button> from the design system instead of <button>."
          },
          {
            "element": "select",
            "message": "Use <Select> from the design system instead of <select>."
          },
          {
            "element": "input",
            "message": "Use <Slider> from the design system instead of <input>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/general/ActionButton/**",
              "components/general/Button/**",
              "components/general/ButtonGroup/**",
              "components/general/RoomSection/**",
              "components/general/Section/**",
              "components/general/Select/**",
              "components/general/Sidebar/**",
              "components/general/Slider/**",
              "components/general/SpeakersSection/**",
              "components/general/Switch/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:DM Sans))/i]",
        "message": "Font not provided by the design system. Available: DM Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|cta|disabled|onClick|key|ref|className|style|children)$/]",
        "message": "<ActionButton> doesn't accept that prop. Declared props: children, variant, cta, disabled, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|utility|danger)$/]",
        "message": "<ActionButton> variant must be one of 'primary' | 'secondary' | 'utility' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|active|disabled|title|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, active, disabled, title, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|reset)$/]",
        "message": "<Button> variant must be one of 'default' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|key|ref|className|style|children)$/]",
        "message": "<ButtonGroup> doesn't accept that prop. Declared props: options, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoomSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|length|height|onChange|key|ref|className|style|children)$/]",
        "message": "<RoomSection> doesn't accept that prop. Declared props: width, length, height, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|key|ref|className|style|children)$/]",
        "message": "<Section> doesn't accept that prop. Declared props: label, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|disabled|label|onChange|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: options, value, disabled, label, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sidebar'] > JSXAttribute > JSXIdentifier[name!=/^(?:header|children|width|key|ref|className|style|children)$/]",
        "message": "<Sidebar> doesn't accept that prop. Declared props: header, children, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|min|max|step|unit|display|disabled|onChange|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: label, value, min, max, step, unit, display, disabled, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpeakersSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:speakerType|spacing|distance|toeIn|onChange|key|ref|className|style|children)$/]",
        "message": "<SpeakersSection> doesn't accept that prop. Declared props: speakerType, spacing, distance, toeIn, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpeakersSection'] > JSXAttribute[name.name='speakerType'] > Literal[value!=/^(?:standmount|floorstander|statement|panel|monitor)$/]",
        "message": "<SpeakersSection> speakerType must be one of 'standmount' | 'floorstander' | 'statement' | 'panel' | 'monitor'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|disabled|label|onChange|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, disabled, label, onChange."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "ActionButton": {
        "replaces": []
      },
      "Button": {
        "replaces": [
          "button"
        ]
      },
      "ButtonGroup": {
        "replaces": []
      },
      "RoomSection": {
        "replaces": []
      },
      "Section": {
        "replaces": []
      },
      "Select": {
        "replaces": [
          "select"
        ]
      },
      "Sidebar": {
        "replaces": []
      },
      "Slider": {
        "replaces": [
          "input[type=range]"
        ]
      },
      "SpeakersSection": {
        "replaces": []
      },
      "Switch": {
        "replaces": []
